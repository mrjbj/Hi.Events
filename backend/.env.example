APP_NAME=Hi.Events
APP_ENV=local
APP_KEY=base64:DwMidgIu8YVSEg0BLMrh5JS2dk1POpCn3rvDaZk3fEQ=
APP_DEBUG=true
APP_LOG_QUERIES=false
APP_URL=http://localhost
APP_PORT=1234
APP_FRONTEND_URL=https://localhost:8443
APP_CDN_URL=http://localhost:9000/hievents-public
APP_SAAS_MODE_ENABLED=false
APP_SAAS_STRIPE_APPLICATION_FEE_PERCENT=1.5
APP_HOMEPAGE_VIEWS_UPDATE_BATCH_SIZE=8
APP_DISABLE_REGISTRATION=false
APP_STRIPE_CONNECT_ACCOUNT_TYPE=express
APP_PLATFORM_SUPPORT_EMAIL=support@your-website.com
APP_ALLOWED_INTERNAL_WEBHOOK_HOSTS=

# Public checkout email-based contact lookup (name-only). Off by default;
# it's an unauthenticated PII surface. Leave false unless you've reviewed
# the throttling in RouteServiceProvider and understand the privacy trade-off.
CONTACT_LOOKUP_ENABLED=false

# Log channel for /contact-lookup traffic (for monitoring/abuse detection).
# 'stack' uses the app's main logger. Point at a dedicated channel for
# cleaner log-based alerting.
CONTACT_LOOKUP_LOG_CHANNEL=stack

# Cloudflare Turnstile (invisible CAPTCHA) for the contact-lookup endpoint.
# The backend only verifies tokens, so it only needs the secret key. The
# site key lives in the frontend as VITE_TURNSTILE_SITE_KEY (frontend/.env).
# Dev: leave disabled, or use the always-pass test secret (no account needed):
#   TURNSTILE_ENABLED=true
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
#   (frontend) VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Prod: register your hostname at https://dash.cloudflare.com/?to=/:account/turnstile
# and paste the real secret below (site key goes in frontend/.env).
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=

# TTL (days) for signed contact tokens embedded in outbound emails as ?c=<token>.
# Tokens let returning contacts prefill checkout and self-serve their profile.
CONTACT_TOKEN_TTL_DAYS=30

STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Comma-separated list of allowed Origins. Dev can stay wide open with *,
# but production MUST be set to your specific frontend domain(s), e.g.:
#   CORS_ALLOWED_ORIGINS=https://events.district11ga.org
# A wildcard here in production lets any website call your API.
CORS_ALLOWED_ORIGINS=*

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=backend
DB_USERNAME=username
DB_PASSWORD=password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_PUBLIC_DISK=s3-public
FILESYSTEM_PRIVATE_DISK=s3-private
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=app
AWS_SECRET_ACCESS_KEY=password
AWS_DEFAULT_REGION=us-east-1
AWS_PUBLIC_BUCKET=hievents-public
AWS_PRIVATE_BUCKET=hievents-private
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

JWT_SECRET=2hoccgHb9r1fqW1lU16C6khSHVa7O0eai6FxkWK95UtQ0LqNDTO5mq1RzDwcq18I
JWT_ALGO=HS256

# SES Bounce/Complaint Handling
