# Hi.Events (fork) — environment reference. NOT loaded by anything; do not copy to .env.
#
# Three places this app runs:
#
#   1. DEV STACK      bin/dev-up    https://localhost:8443 (hot reload; backend :1234, mailpit :8025, minio :8900)
#                     compose: docker/development/docker-compose.dev.yml + docker-compose.secrets.yml (ours)
#   2. LOCAL AIO      bin/aio-up    http://localhost:8123 (builds the prod-shaped all-in-one image locally;
#                     validates a release without GitHub Actions -> GHCR -> Elestio)
#   3. PROD           district11 (Elestio): ~/elestio_app_directory/hi-events, image ghcr.io/mrjbj/hi-events-all-in-one
#                     compose copy: ops/elestio/docker-compose.prod.yml; values in that server dir's .env (no sops on district11)
#
# Where each kind of value lives (dev + local aio):
#   secrets  -> `sedit hi-events`  (nix-darwin-2025 home/SHARED/secrets/projects/hi-events.env), loaded by .envrc
#   config   -> .envrc             compose ${...} values for the dev stack
#            -> backend/.env       Laravel config, NO secrets (Laravel/upstream convention; the one sanctioned .env)
#            -> frontend/.env      VITE_* values, all public
#            -> bin/aio-up         local-aio URLs/disks, inline
# Laravel's env is immutable: real env vars (from compose) win over backend/.env.
# docker/development/.env is upstream's placeholder file, kept only to avoid merge conflicts; the
# direnv shell overrides every value in it.

# --- secrets (sedit hi-events) ---
APP_KEY=                    # base64:... — Laravel encrypter (sessions, 48h invite/confirm links). php artisan key:generate --show
JWT_SECRET=                 # login tokens. openssl rand -base64 32
DB_PASSWORD=                # local pgsql container (dev stack)
STRIPE_SECRET_KEY=          # sk_test_... (dev); prod uses live keys on district11
STRIPE_WEBHOOK_SECRET=      # whsec_...
# TURNSTILE_SECRET_KEY=     # only if TURNSTILE_ENABLED=true
DISTRICT11_POSTGRES_PASSWORD=   # PROD DB over the ssh tunnel (localhost:15432) for nvim dadbod / priv/doc scripts

# --- dev stack compose values (.envrc) ---
APP_NAME=Hi.Events
APP_ENV=local
APP_DEBUG=true
API_URL_CLIENT=https://localhost:8443/api
API_URL_SERVER=http://backend:8080
FRONTEND_URL=https://localhost:8443
STRIPE_PUBLIC_KEY=pk_test_...           # public; also feeds VITE_STRIPE_PUBLISHABLE_KEY
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=backend
DB_USERNAME=username

# --- backend/.env (config only; see backend/.env.example for every option) ---
# APP_URL APP_FRONTEND_URL APP_CDN_URL LOG_* CACHE_DRIVER QUEUE_CONNECTION SESSION_* REDIS_*
# MAIL_* -> mailpit (MAIL_USERNAME/PASSWORD are local throwaways)
# AWS_* / FILESYSTEM_* -> local minio (app/password are local throwaways)
# STRIPE_PUBLIC_KEY CONTACT_LOOKUP_* TURNSTILE_ENABLED CORS_ALLOWED_ORIGINS SES_SUPPRESSION_ENABLED ...

# --- frontend/.env (all public) ---
# VITE_API_URL_CLIENT 
# VITE_API_URL_SERVER 
# VITE_FRONTEND_URL 
# VITE_STRIPE_PUBLISHABLE_KEY 
# VITE_TURNSTILE_SITE_KEY

# --- prod (district11 .env; names from ops/elestio/docker-compose.prod.yml) ---
# secrets: 
# APP_KEY 
# JWT_SECRET 
# STRIPE_SECRET_KEY 
# STRIPE_WEBHOOK_SECRET
# MAIL_USERNAME 
# MAIL_PASSWORD (SES SMTP)
# POSTGRES_PASSWORD 
# TURNSTILE_SECRET_KEY 
# PGADMIN_DEFAULT_PASSWORD
# config:  
# APP_FRONTEND_URL 
# APP_CDN_URL 
# VITE_* 
# MAIL_HOST/PORT/FROM_* SES_* 
# AWS_SNS_* 
# PHP_FPM_PM_* 
# CONTACT_LOOKUP_* ...
