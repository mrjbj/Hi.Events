#!/usr/bin/env bash
# Start the dev stack (hot reload): https://localhost:8443, backend :1234, mailpit :8025, minio :8900.
# Config: backend/.env (config only) + .envrc. Secrets: `use sops hi-events` via
# docker/development/docker-compose.secrets.yml. Extra args go to `docker compose`
# (default: up -d). Examples: bin/dev-up        bin/dev-up logs -f backend        bin/dev-up down
# First-time install (composer, migrations, certs): docker/development/start-dev.sh
set -euo pipefail
repo=$(cd "$(dirname "$0")/.." && pwd)
cd "$repo/docker/development"
# Services listed explicitly to skip upstream's one-shot `createbuckets` (minio/mc is no
# longer on Docker Hub); the buckets already live in the development_app-minio volume.
[[ $# -eq 0 ]] && set -- up -d backend frontend nginx minio
exec direnv exec "$repo" docker compose -f docker-compose.dev.yml -f docker-compose.secrets.yml "$@"
